[Unit]
Description=Synquic Model Arena (FastAPI backend)
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/synquic_app
EnvironmentFile=/home/ubuntu/synquic_app/.env
ExecStart=/home/ubuntu/synquic_env/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
